string(TIMESTAMP OPENMAVER_BUILD_DATE "%Y-%m-%d")
set(OPENMAVER_MOD_JAR "${OPENMAVER_OUTPUT_DIR}/openmaver-b2.2.0-${OPENMAVER_BUILD_DATE}.jar")

execute_process(
    COMMAND "${OPENMAVER_JAR_EXECUTABLE}" cf "${OPENMAVER_MOD_JAR}"
            -C "${OPENMAVER_MC_REOBF_DIR}" .
            -C "${OPENMAVER_JAVA_CLASSES_DIR}" .
            -C "${OPENMAVER_MOD_STAGE}" .
    RESULT_VARIABLE OPENMAVER_JAR_RESULT
)
if(NOT OPENMAVER_JAR_RESULT EQUAL 0)
    message(FATAL_ERROR "Failed to package ${OPENMAVER_MOD_JAR}: ${OPENMAVER_JAR_RESULT}")
endif()
message(STATUS "Packed ${OPENMAVER_MOD_JAR}")
