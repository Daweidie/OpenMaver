// ---------------------------------------------------------------------------
// OpenMaver B2.1.2 默认配置（JSONC：支持 // 行注释与 /* */ 块注释）
//
// 大多数功能模块默认 enabled: false；FPS / CPS 统计与日志工具默认开启。
// 嵌套 key 通过点号访问，例如：combat.aimassist.enabled
//
// 模块配置路径约定（见 module.Module）：
//   包名去掉根包 "module" + "." + 类名小写
//   例如 module.movement.AutoSprint -> movement.autosprint
//
// Grim 对测 profile 不在这里，而在 config/openmaver.properties：
//   bypass.enabled=true
//   bypass.profile=balanced     // legit | balanced | aggressive
//   debug.enabled=false         // 写入 logs/openmaver-debug.log
// ---------------------------------------------------------------------------
{
  // 移动相关模块
  "movement": {
    "autosprint": {
      "enabled": false,        // 示例模块 AutoSprint：默认关闭（链路验证时可临时改为 true）
      "key": "V"               // 绑定键位（按 V 切换）
    },
    "scaffold": {
      "enabled": false,        // Scaffold 搭桥（OpenZen 移植）：默认关闭
      "key": ""                // 不绑定默认热键
    },
    "telly": {
      "enabled": false,        // Telly 跑跳搭路（OpenZen Telly Bridge / Old Telly）
      "key": ""                // 在 ClickGUI 中开启或自行绑定热键
    },
    "safewalk": {
      "enabled": false,        // SafeWalk 方块边缘潜行（从 Scaffold 的 eagle 拆出）：默认关闭
      "key": ""                // 不绑定默认热键
    },
    "godbridge": {
      "enabled": false,        // 神桥/蹲起搭路（教材三种手法）：默认关闭（按 N 切换）
      "key": "N"               // 绑定键位（按 N 切换）
    },
    "scaffold2": {
      "enabled": false,        // 教材式手动搭路辅助：默认关闭（按 G 切换）
      "key": "G"               // 绑定键位（按 G 切换）
    },
    "attackreduce": {
      "enabled": false,        // Velocity 防击退：默认关闭（参数在 ClickGUI 中调整）
      "key": ""               // 默认不占用按键，玩家可自行绑定
    }
  },

  // 战斗相关模块
  "combat": {
    "aimassist": {
      "enabled": false,        // 瞄准辅助：默认关闭
      "key": "C",              // 绑定键位
      "speed": 0.15,           // 平滑速度（0.0 ~ 1.0）
      "maxDistance": 6.0       // 最大作用距离（单位：方块）
    },
    "autoclicker": {
      "enabled": false,        // 自动点击器：默认关闭
      "key": "R"               // 绑定键位（按 R 切换；默认 6~10 CPS）
    },
    "reach": {
      "enabled": false,        // Reach 攻击距离：默认关闭
      "key": "K"               // 绑定键位（按 K 切换）
    },
    "criticals": {
      "enabled": false,        // 刀暴/强制暴击：默认关闭（JUMP 模式：真实起跳后才暴击，不发伪造移动包）
      "key": ""                // 默认不占用按键，玩家可自行绑定
    },
    "killaura": {
      "enabled": false,        // KillAura 自动攻击：默认关闭（参数在 ClickGUI 中调整）
      "key": ""                // 默认不占用按键，玩家可自行绑定
    }
  },

  // 玩家相关模块
  "player": {
    "fastplace": {
      "enabled": false,        // 快速右键：默认关闭（DELAY / JITTER 在 ClickGUI 里调）
      "key": "F"               // 绑定键位（按 F 切换）
    },
    "cheststealer": {
      "enabled": false,        // 快速开箱：箱子界面打开后自动把物资搬进背包（参数在 ClickGUI）
      "key": ""                // 默认不占用按键，玩家可自行绑定
    },
    "inventorymanager": {
      "enabled": false,        // 自动整理背包：穿盔甲 / 排快捷栏 / 丢多余装备（参数在 ClickGUI）
      "key": ""                // 默认不占用按键，玩家可自行绑定
    }
  },

  // 渲染相关模块
  "render": {
    "esp": {
      "enabled": false,        // 透视标记：默认关闭
      "key": "X",              // 绑定键位
      "color": "#FFFFFF",      // 颜色（十六进制 RGB）
      "thickness": 1.5,        // 线宽
      "maxDistance": 64        // 最大渲染距离（单位：方块）
    },
    "targethud": {
      "enabled": false,        // 目标信息面板：默认关闭（按 H 切换）
      "key": "H"               // 绑定键位
    },
    "playerxray": {
      "enabled": false,        // 玩家透视：默认关闭（按 J 切换）
      "key": "J"               // 绑定键位
    },
    "motionblur": {
      "enabled": false,        // 运动模糊：默认关闭（按 M 切换；静止时零开销）
      "key": "M"               // 绑定键位
    },
    "chestesp": {
      "enabled": false,        // 箱子透视：箱子/末影箱/漏斗外框，默认关闭（按 P 切换）
      "key": "P"               // 绑定键位
    },
    "fullbright": {
      "enabled": false,        // 全亮/夜视：默认关闭（按 Y 切换）
      "key": "Y"               // 绑定键位
    },
    "fps": {
      "enabled": true,         // 左上角 FPS 显示：默认开启
      "key": ""                // 可选键位；留空表示不绑定
    },
    "cps": {
      "enabled": true,         // 左上角 CPS 小方块（左/右键）：默认开启
      "key": ""                // 可选键位；留空表示不绑定
    }
  },

  // 杂项模块
  "misc": {
    "movedisabler": {
      "enabled": false,        // 背包/箱子界面移动，附带冲刺期间的窗口包处理
      "key": ""                // 默认不占用按键
    },
    "fakeplayer": {
      "enabled": false,        // 假人玩家：默认关闭（按 N 生成/移除假人）
      "key": "N"               // 绑定键位（按 N 切换）
    }
  },

  // 工具类模块
  "tools": {
    "logger": {
      "enabled": true,         // 日志系统默认开启
      "path": "./logs/openmaver.log"
    }
  }
}
